# Supabase project settings (Project Settings > API). The publishable key is safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Used for AI suggestions.
OPENAI_API_KEY=
# OpenAI model used for suggestions.
OPENAI_MODEL=gpt-5.4-mini
# Maximum AI suggestions per coach per UTC day.
AI_DAILY_LIMIT=25

# Free key: https://fdc.nal.usda.gov/api-key-signup (falls back to DEMO_KEY).
USDA_FDC_API_KEY=

# Web Push: generate a pair once with `npx web-push generate-vapid-keys`.
# Public key is safe for browsers. VAPID_PUBLIC_KEY is a server-side fallback.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only: never expose these through NEXT_PUBLIC_* or commit real values.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Stripe Connect payments and webhook signature verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
